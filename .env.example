# Always required: the frozen credence and prompt judges.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Target / auditor providers as needed.
ANTHROPIC_API_KEY=

# Optional: max output tokens for Bloom scenario generation via `pander-bloom`
# (default: Inspect model info, or 8192 for unknown models).
BLOOM_MAX_OUTPUT_TOKENS=128000

# To store logs on AWS S3 for sharing, set the following environment variables:
INSPECT_LOG_DIR=s3://sophron-eval-logs/<your-name>
AWS_PROFILE=sophron
